{
  "manifest_version": 3,
  "name": "BTC-Lab chat bridge",
  "version": "0.1.0",
  "description": "Relay local BTC-Lab job completion to one explicitly selected conversation.",
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "http://127.0.0.1:18746/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}